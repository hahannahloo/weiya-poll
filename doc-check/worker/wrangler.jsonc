{
  "name": "doc-check-api",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "durable_objects": {
    "bindings": [{ "name": "DB", "class_name": "Store" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Store"] }],
  "triggers": { "crons": ["0 18 * * *"] },
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }]
}
